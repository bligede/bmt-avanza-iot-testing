#pragma once

// --- Phone hotspot -----------------------------------------------------------
// The ESP32-S3 radio is 2.4 GHz ONLY. If the hotspot is set to 5 GHz, or to
// "auto" and the phone picks 5 GHz, the device will never find it and the
// symptom is an endless CONNECTING -> IDLE loop in the log.
//
// On Android:  Hotspot settings -> AP Band -> 2.4 GHz
// On iPhone:   enable "Maximise Compatibility" (that is the 2.4 GHz switch)
//
// Give the hotspot a distinct SSID rather than reusing a home network name.
// A technician chasing "why is there no dashboard" should not also be working
// out which access point the device joined.
#define WIFI_SSID   "avanza-test"
#define WIFI_PASS   "CHANGE-ME"
